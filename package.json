{
  "name": "leanai",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "LeanAI \u2014 Less noise. Less cost. More value. Decision intelligence, MCP, A2A, lean data preparation, AI economics and MBSE-backed engineering decisions.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "start:live": "node server/rail-live.mjs",
    "film:preview": "node scripts/film.mjs --preview",
    "film": "node scripts/film.mjs",
    "film:google": "node scripts/film.mjs --google",
    "film:google:preview": "node scripts/film.mjs --google --preview",
    "video:preview": "npm --prefix video run video:preview",
    "video:render": "npm --prefix video run video:render"
  },
  "optionalDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@google/adk": "2.2.0",
    "@google/genai": "2.27.0",
    "@modelcontextprotocol/sdk": "1.32.0"
  }
}
