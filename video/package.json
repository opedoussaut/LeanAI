{
  "name": "leanai-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LeanAI \u2014 The Right Intelligence. Cinematic film rendered with Remotion. Isolated from the LeanAI web application.",
  "scripts": {
    "video:preview": "remotion studio src/index.ts",
    "video:render": "npm run video:audio && remotion render src/index.ts LeanAIFilm output/leanai-right-intelligence.mp4 --codec=h264 --crf=16 && npm run video:poster",
    "video:poster": "remotion still src/index.ts LeanAIFilm output/leanai-right-intelligence-poster.jpg --frame=1680 --image-format=jpeg --jpeg-quality=92",
    "video:audio": "npm run video:cues && python3 audio/synth.py",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/simulation.test.ts",
    "video:cues": "node --experimental-strip-types --no-warnings scripts/export-cues.ts",
    "tune": "node --experimental-strip-types --no-warnings scripts/tune-reflex.ts --check",
    "tune:search": "node --experimental-strip-types --no-warnings scripts/tune-reflex.ts 20000",
    "tune:planning": "node --experimental-strip-types --no-warnings scripts/tune-planning.ts --check"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "^4.0.533",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.533"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.533",
    "@remotion/renderer": "^4.0.533",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "typescript": "^7.0.2"
  }
}
