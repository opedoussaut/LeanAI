# Industrial Recovery — LIVE mode only (npm run start:live). Never commit a real key.
# Without these variables everything runs in SIMULATED mode.
GEMINI_API_KEY=
# Optional: any Gemini model id available to your key (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
# Optional: port of the local live endpoint the page calls with ?provider=live
RAIL_LIVE_PORT=18800
